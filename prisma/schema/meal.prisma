model Meal {
  id                 Int    @id @default(autoincrement())
  name               String
  image              String?  
  description        String
  cuisine_type       Int
  dietry_type        Int
  category           Int
  availabilty_status String
  price              Int

  provider_id String
  provider    User   @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  category_rel Categories  @relation(fields: [category], references: [id])
  cuisine_rel  Cuisinetype @relation(fields: [cuisine_type], references: [id])
  dietry_rel   Dietrytype  @relation(fields: [dietry_type], references: [id])

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}
