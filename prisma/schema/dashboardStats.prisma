model DashboardStats {
    id                   String @id @default(uuid())
    year                 Int
    month                Int
    usersJoined          Int    @default(0)
    providersJoined      Int    @default(0)
    mealsCreated         Int    @default(0)
    reviewsCreated       Int    @default(0)
    globalReviewsCreated Int    @default(0)
    ordersCreated        Int    @default(0)
    orderItemsCreated    Int    @default(0)

    @@unique([year, month])
}
