

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Categories {
  id            String   @id @default(uuid())
  category_name String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  meals         Meal[]
}

model Cuisinetype {
  id                String   @id @default(uuid())
  cuisine_type_name String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  meals             Meal[]
}

model Dietrytype {
  id               String   @id @default(uuid())
  dietry_type_name String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  meals            Meal[]
}
