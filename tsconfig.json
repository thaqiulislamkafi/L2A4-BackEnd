{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
  ]
}